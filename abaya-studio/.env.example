# --- Security (required in production) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Data ---
# JSON file used by the bundled repository adapter, or "memory".
DATA_FILE=data/db.json
UPLOAD_DIR=data/uploads
DEFAULT_STORE_ID=demo
# Seed the demo store + ~2k demo designs on first boot (set 0 to disable).
SEED_DEMO=1

# --- Merchant sign-in (Email OTP) ---
# "open" lets any email create a merchant on the default store (demo/onboarding).
# Defaults to open in development and closed in production.
# MERCHANT_SIGNUP=open
# Show the OTP on screen in production (demos only).
# DEMO_MODE=1

# --- AI image generation ---
# Without a key, the studio uses the built-in illustration renderer.
# AI_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
