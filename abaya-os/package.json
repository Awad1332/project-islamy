{
  "name": "abaya-os",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
    "build:shared": "pnpm --filter @abaya/shared build",
    "dev:api": "pnpm --filter @abaya/api start:dev",
    "dev:web": "pnpm --filter @abaya/web dev",
    "db:migrate": "pnpm --filter @abaya/api prisma:migrate",
    "db:seed": "pnpm --filter @abaya/api prisma:seed",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
