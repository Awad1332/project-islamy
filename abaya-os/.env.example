# Root environment for docker-compose. Generate secrets with: openssl rand -hex 32
POSTGRES_USER=abaya
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=abaya_os

APP_URL=http://localhost:3000
# 64+ chars recommended
JWT_ACCESS_SECRET=
# exactly 64 hex chars (32 bytes) — AES-256-GCM key for integration credentials
ENCRYPTION_KEY=
# set to true behind HTTPS
COOKIE_SECURE=false

S3_ACCESS_KEY_ID=abaya-minio
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_BUCKET=abaya-media
S3_REGION=me-central-1
S3_PUBLIC_URL=http://localhost:9000/abaya-media

# Optional platform-wide AI key (tenants can also bring their own under Integrations)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Used by the seed (docker compose exec api npx ts-node --transpile-only prisma/seed.ts)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
