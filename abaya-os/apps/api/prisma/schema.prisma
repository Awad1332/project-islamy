generator client {
  provider      = "prisma-client-js"
  // native = dev machine; linux-musl-openssl-3.0.x = the node:22-alpine container
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  SUPPORT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  ADJUSTMENT
  RECEIPT
  SALE
  RETURN_RESTOCK
  CANCEL_RESTOCK
  TRANSFER_IN
  TRANSFER_OUT
}

enum IntegrationProvider {
  ANTHROPIC
  MOYASAR
  TAP
  WHATSAPP_CLOUD
  INSTAGRAM
  SMTP
  SALLA
  ZID
  IMAGE_GENERATION
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  VERIFIED
  FAILED
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  EMAIL
  SMS
  WEBCHAT
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  NOTE
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  FAILED
  NOT_SENT
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum AutomationTrigger {
  ORDER_CREATED
  ORDER_DELIVERED
  CUSTOMER_CREATED
  RETURN_REQUESTED
}

enum AiGenerationType {
  PRODUCT_TITLE
  PRODUCT_DESCRIPTION
  SEO
  INSTAGRAM_CAPTION
}

enum ImageJobType {
  BACKGROUND_REMOVAL
  MODEL_TRY_ON
  LIFESTYLE_SCENE
  COLOR_VARIANT
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FitPreference {
  SNUG
  REGULAR
  LOOSE
}

// ---------------- Identity & tenancy ----------------

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  locale          String         @default("ar")
  isPlatformAdmin Boolean        @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  memberships     Membership[]
  refreshTokens   RefreshToken[]
}

model Tenant {
  id                 String          @id @default(cuid())
  slug               String          @unique
  nameAr             String
  nameEn             String?
  status             TenantStatus    @default(ACTIVE)
  isDemo             Boolean         @default(false)
  logoUrl            String?
  contactEmail       String?
  contactPhone       String?
  vatEnabled         Boolean         @default(true)
  vatRateBps         Int             @default(1500)
  pricesIncludeVat   Boolean         @default(true)
  vatNumber          String?
  commercialRegistration String?
  currency           String          @default("SAR")
  timezone           String          @default("Asia/Riyadh")
  defaultLocale      String          @default("ar")
  addressCity        String?
  addressLine        String?
  lowStockThreshold  Int             @default(3)
  defaultShippingFee Int             @default(0)
  freeShippingThreshold Int?
  orderSequence      Int             @default(1000)
  returnSequence     Int             @default(100)
  onboardingDismissed Boolean        @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  memberships        Membership[]
  subscription       Subscription?
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       Role
  tokenHash  String    @unique
  invitedById String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------- Billing ----------------

model Plan {
  id               String         @id @default(cuid())
  code             String         @unique
  nameAr           String
  nameEn           String
  priceMonthly     Int
  priceYearly      Int
  maxProducts      Int
  maxStaff         Int
  aiCreditsMonthly Int
  features         String[]
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  interval           BillingInterval    @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  aiCreditsUsed      Int                @default(0)
  providerRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  invoices           BillingInvoice[]
}

model BillingInvoice {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  number         String       @unique
  amount         Int
  vatAmount      Int
  total          Int
  status         String       @default("OPEN") // OPEN | PAID | VOID
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  providerRef    String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ---------------- Catalog ----------------

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  slug      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, slug])
}

model Product {
  id                 String           @id @default(cuid())
  tenantId           String
  titleAr            String
  titleEn            String?
  descriptionAr      String?
  descriptionEn      String?
  slug               String
  status             ProductStatus    @default(DRAFT)
  categoryId         String?
  sizeChartId        String?
  cut                String?
  fabric             String?
  sleeveType         String?
  closure            String?
  embellishment      String?
  opacity            String?
  occasions          String[]
  includesShayla     Boolean          @default(false)
  careInstructionsAr String?
  careInstructionsEn String?
  seoTitle           String?
  seoDescription     String?
  tags               String[]
  externalRef        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeChart          SizeChart?       @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  images             ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model ProductVariant {
  id             String           @id @default(cuid())
  tenantId       String
  productId      String
  sku            String
  size           String
  color          String
  colorHex       String?
  length         String?
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  barcode        String?
  weightGrams    Int?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      InventoryLevel[]
  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@index([productId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  key         String   @unique
  url         String
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  assetId   String
  url       String
  altAr     String?
  altEn     String?
  position  Int      @default(0)
  color     String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------- Inventory ----------------

model Location {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  city      String?
  isDefault Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  levels    InventoryLevel[]

  @@unique([tenantId, name])
}

model InventoryLevel {
  id         String         @id @default(cuid())
  tenantId   String
  variantId  String
  locationId String
  onHand     Int            @default(0)
  updatedAt  DateTime       @updatedAt
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([tenantId])
}

model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  variantId  String
  locationId String
  type       StockMovementType
  quantity   Int
  balance    Int
  reference  String?
  note       String?
  userId     String?
  createdAt  DateTime          @default(now())

  @@index([tenantId, variantId, createdAt])
}

// ---------------- CRM ----------------

model Customer {
  id               String                @id @default(cuid())
  tenantId         String
  fullName         String
  phone            String?
  email            String?
  city             String?
  district         String?
  addressLine      String?
  birthday         DateTime?
  tags             String[]
  acceptsMarketing Boolean               @default(false)
  notes            String?
  ordersCount      Int                   @default(0)
  totalSpent       Int                   @default(0)
  lastOrderAt      DateTime?
  externalRef      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  measurements     CustomerMeasurement[]
  orders           Order[]
  timeline         CustomerNote[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

model CustomerMeasurement {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  label         String        @default("default")
  height        Float?
  bust          Float?
  waist         Float?
  hips          Float?
  shoulder      Float?
  armLength     Float?
  fitPreference FitPreference @default(REGULAR)
  wearsHeels    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ---------------- Orders ----------------

model Order {
  id               String        @id @default(cuid())
  tenantId         String
  number           String
  customerId       String?
  channel          String        @default("MANUAL")
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?
  locationId       String?
  currency         String        @default("SAR")
  vatRateBps       Int
  pricesIncludeVat Boolean
  subtotal         Int
  discountTotal    Int
  shippingTotal    Int
  vatTotal         Int
  total            Int
  amountPaid       Int           @default(0)
  amountRefunded   Int           @default(0)
  shippingName     String?
  shippingPhone    String?
  shippingCity     String?
  shippingDistrict String?
  shippingAddress  String?
  carrier          String?
  trackingNumber   String?
  notes            String?
  giftMessage      String?
  externalRef      String?
  createdById      String?
  placedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  returns          ReturnRequest[]

  @@unique([tenantId, number])
  @@index([tenantId, placedAt])
  @@index([tenantId, status])
}

model OrderItem {
  id           String         @id @default(cuid())
  tenantId     String
  orderId      String
  variantId    String
  productTitle String
  sku          String
  size         String
  color        String
  length       String?
  quantity     Int
  unitPrice    Int
  discount     Int            @default(0)
  netTotal     Int
  vatTotal     Int
  total        Int
  returnedQty  Int            @default(0)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  returnItems  ReturnItem[]

  @@index([orderId])
  @@index([tenantId, variantId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  type      String
  message   String?
  userId    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  amount      Int
  method      String
  kind        String   @default("CAPTURE") // CAPTURE | REFUND
  reference   String?
  provider    String   @default("MANUAL")
  recordedBy  String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------- Returns & exchanges ----------------

model ReturnRequest {
  id                 String       @id @default(cuid())
  tenantId           String
  number             String
  orderId            String
  type               ReturnType
  status             ReturnStatus @default(REQUESTED)
  reason             String
  reasonNote         String?
  refundAmount       Int          @default(0)
  restocked          Boolean      @default(false)
  replacementOrderId String?
  resolutionNote     String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items              ReturnItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ReturnItem {
  id                String        @id @default(cuid())
  tenantId          String
  returnId          String
  orderItemId       String
  quantity          Int
  exchangeVariantId String?
  returnRequest     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem         OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
}

// ---------------- Sizing ----------------

model SizeChart {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  isDefault       Boolean   @default(false)
  weights         Json
  rows            Json
  lengthRows      Json
  heelAllowanceCm Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([tenantId])
}

model SizeRecommendation {
  id          String   @id @default(cuid())
  tenantId    String
  sizeChartId String
  productId   String?
  customerId  String?
  input       Json
  result      Json
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------- AI ----------------

model AiGeneration {
  id           String           @id @default(cuid())
  tenantId     String
  userId       String?
  productId    String?
  type         AiGenerationType
  locale       String
  provider     String
  model        String
  prompt       String
  output       String
  inputTokens  Int              @default(0)
  outputTokens Int              @default(0)
  appliedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
}

model ImageJob {
  id            String       @id @default(cuid())
  tenantId      String
  userId        String?
  productId     String?
  type          ImageJobType
  status        JobStatus    @default(QUEUED)
  sourceAssetId String
  resultAssetId String?
  prompt        String?
  provider      String?
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, createdAt])
}

// ---------------- Marketing ----------------

model Segment {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?
  rules       Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]

  @@index([tenantId])
}

model Campaign {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  channel        CampaignChannel
  segmentId      String
  subject        String?
  bodyAr         String
  bodyEn         String?
  status         CampaignStatus  @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int             @default(0)
  sentCount      Int             @default(0)
  failedCount    Int             @default(0)
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  segment        Segment         @relation(fields: [segmentId], references: [id])

  @@index([tenantId])
}

model Automation {
  id           String            @id @default(cuid())
  tenantId     String
  name         String
  trigger      AutomationTrigger
  channel      CampaignChannel
  delayMinutes Int               @default(0)
  bodyAr       String
  bodyEn       String?
  isActive     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  runs         AutomationRun[]

  @@index([tenantId, trigger])
}

model AutomationRun {
  id           String     @id @default(cuid())
  tenantId     String
  automationId String
  customerId   String?
  entityId     String?
  status       String     // SCHEDULED | SENT | SKIPPED | FAILED
  detail       String?
  runAt        DateTime
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ---------------- Inbox ----------------

model Channel {
  id            String         @id @default(cuid())
  tenantId      String
  type          ChannelType
  name          String
  externalId    String?
  integrationId String?
  createdAt     DateTime       @default(now())
  conversations Conversation[]

  @@index([tenantId])
}

model Conversation {
  id            String             @id @default(cuid())
  tenantId      String
  channelId     String
  customerId    String?
  contactHandle String
  subject       String?
  status        ConversationStatus @default(OPEN)
  assigneeId    String?
  lastMessageAt DateTime           @default(now())
  unreadCount   Int                @default(0)
  createdAt     DateTime           @default(now())
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  direction      MessageDirection
  status         MessageStatus
  body           String
  authorId       String?
  externalId     String?
  error          String?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------- Integrations & developer ----------------

model Integration {
  id               String              @id @default(cuid())
  tenantId         String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(NOT_CONFIGURED)
  credentialsEnc   String?
  settings         Json                @default("{}")
  lastVerifiedAt   DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([tenantId, provider])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  prefix     String
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdById String?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  tenantId   String
  url        String
  events     String[]
  secretEnc  String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  tenantId     String
  endpointId   String
  event        String
  payload      Json
  status       String          // PENDING | SUCCEEDED | FAILED
  attempts     Int             @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime        @default(now())
  deliveredAt  DateTime?
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
